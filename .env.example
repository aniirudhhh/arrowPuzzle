# Server-only Supabase Transaction pooler URI (Connect > Transaction pooler).
# Replace placeholders and URL-encode special characters in the password.
# Never prefix this with NEXT_PUBLIC_. Leave blank to use local storage during development.
DATABASE_URL=

# Supabase Database Settings > SSL Configuration > Download Certificate.
# Paste the full PEM certificate, with actual newlines or literal \n separators.
DATABASE_CA_CERT=

# Optional single-line base64-encoded PEM; takes precedence over DATABASE_CA_CERT.
DATABASE_CA_CERT_BASE64=
# Optional Google Search Console HTML-tag verification token (not the whole tag).
GOOGLE_SITE_VERIFICATION=

# Realtime: public project URL and publishable key (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
